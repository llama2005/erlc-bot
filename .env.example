# --- Required ---
# Discord bot token — https://discord.com/developers/applications → your app → Bot
DISCORD_TOKEN=
# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Postgres connection string — https://neon.tech (free)
DATABASE_URL=

# --- Optional ---
# Set to "production" for the public multi-tenant deploy: disables the shared ERLC_KEY
# fallback (every guild must set its own) and always registers slash commands globally.
# Leave blank / "development" for a self-host or dev instance.
NODE_ENV=
# Dev instances only (NODE_ENV != production): register slash commands to this one guild
# instantly instead of waiting ~1h for global propagation. Ignored in production.
DEV_GUILD_ID=
# Name shown on the dashboard / privacy / terms pages. The bot's live Discord username
# is used instead wherever the dashboard can read it; this is the fallback.
BOT_NAME=Scout
# Default command prefix (per-guild override via the `config` command)
DEFAULT_PREFIX=!
# Comma-separated user IDs that bypass permission checks
OWNER_IDS=

# AI command tuning — model id for the Anthropic API (leave blank for the built-in default)
ANTHROPIC_MODEL=
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=low
MAX_TOKENS=1024
HISTORY_LIMIT=20

# --- ER:LC (Emergency Response: Liberty County) ---
# Dev/self-host only: acts as one implicit ER:LC server when a guild has none connected.
# IGNORED when NODE_ENV=production — there, every guild runs `/erlcserver add`.
ERLC_KEY=
# Optional PRC global API key (approved apps only) — raises rate limits.
ERLC_GLOBAL_KEY=
# How often the auto-logging poller checks the ER:LC API (seconds, min 30)
ERLC_POLL_SECONDS=60

# --- Links shown by /support (optional) ---
SUPPORT_SERVER_URL=
DOCS_URL=

# --- Ops (all optional) ---
# Sentry DSN — enables error reporting + the "Report a problem" button. Unset = off.
SENTRY_DSN=
# Bloxlink API key (https://blox.link dashboard) — enables Roblox<->Discord fallback
# resolution for users who linked via Bloxlink instead of /verify. Unset = off.
BLOXLINK_API_KEY=
# Port for a bare /healthz endpoint on the bot worker (for uptime monitors). Unset = off.
HEALTHCHECK_PORT=
# Set to 1 to run the bot under a ShardingManager. Unset = single process (fine < ~2000 guilds).
SHARDING=

# --- Web dashboard (web/server.js) ---
# Discord Developer Portal → your app → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# any long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# public URL the dashboard is served at (add <URL>/auth/callback as an OAuth redirect)
DASHBOARD_URL=http://localhost:3000
PORT=3000

# --- New feature toggles (optional; all have sensible defaults / configured per-guild) ---
# ERLC_POLL_SECONDS=60   # how often the poller checks the ER:LC API
