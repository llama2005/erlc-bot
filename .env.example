# --- Required ---
# Discord bot token — https://discord.com/developers/applications → your app → Bot
DISCORD_TOKEN=
# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Postgres connection string — https://neon.tech (free)
DATABASE_URL=

# --- Optional ---
# Register slash commands to one guild (instant). Leave blank for global (~1h to propagate).
DEV_GUILD_ID=
# Default command prefix (per-guild override via the `config` command)
DEFAULT_PREFIX=!
# Comma-separated user IDs that bypass permission checks
OWNER_IDS=

# AI command tuning
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max
ANTHROPIC_EFFORT=low
MAX_TOKENS=1024
HISTORY_LIMIT=20

# --- ER:LC (Emergency Response: Liberty County) ---
# Fallback private-server API key, used for guilds that haven't set their own
# via `config erlc-key`. From the ER:LC private server settings → API.
ERLC_KEY=
# Optional PRC global API key (approved apps only) — raises rate limits.
ERLC_GLOBAL_KEY=
# How often the auto-logging poller checks the ER:LC API (seconds, min 30)
ERLC_POLL_SECONDS=60

# --- Links shown by /support (optional) ---
SUPPORT_SERVER_URL=
DOCS_URL=

# --- Web dashboard (web/server.js) ---
# Discord Developer Portal → your app → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# any long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# public URL the dashboard is served at (add <URL>/auth/callback as an OAuth redirect)
DASHBOARD_URL=http://localhost:3000
PORT=3000
