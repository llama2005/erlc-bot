<%- include("partials/head", { title: "Ban requests · " + guild.name }) %>

<div class="page-head">
  <div><h1>Ban requests</h1><div class="sub">Approving runs <code>:ban</code> in-game and opens a case.</div></div>
</div>

<div class="card">
  <h2>Pending — <%= requests.length %></h2>
  <% if (!requests.length) { %><p class="muted">No pending ban requests.</p><% } else { %>
  <div class="stack">
    <% requests.forEach(function(r){ %>
      <div class="card" style="margin:0">
        <div class="row-between">
          <div>
            <a href="https://www.roblox.com/users/<%= r.roblox_id %>/profile" target="_blank"><strong><%= r.roblox_name %></strong></a>
            <span class="muted mono"><%= r.roblox_id %> · request #<%= r.id %> · by <%= who(names, r.requested_by) %> · <%= ago(r.created_at) %></span>
          </div>
          <div class="actions">
            <form method="post" action="/dashboard/<%= guild.id %>/banreqs/<%= r.id %>/approve" onsubmit="return confirm('Approve and ban?')"><button class="btn ok sm">Approve</button></form>
            <form method="post" action="/dashboard/<%= guild.id %>/banreqs/<%= r.id %>/deny"><button class="btn danger sm">Deny</button></form>
          </div>
        </div>
        <p style="margin:10px 0 0"><%= r.reason || "No reason given." %></p>
      </div>
    <% }) %>
  </div>
  <% } %>
</div>

<%- include("partials/foot") %>
