<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark">
<% var appName = (typeof botName !== "undefined" && botName) ? botName : "Scout"; %>
<% var base = (typeof baseUrl !== "undefined" && baseUrl) ? baseUrl : ""; %>
<title><%= typeof title !== "undefined" && title ? title + " · " : "" %><%= appName %></title>
<link rel="stylesheet" href="/static/style.css">
<link rel="icon" type="image/png" href="/static/favicon.png">
<link rel="apple-touch-icon" href="/static/apple-touch-icon.png">
<meta property="og:title" content="<%= typeof title !== 'undefined' && title ? title : appName %>">
<meta property="og:site_name" content="<%= appName %>">
<meta property="og:type" content="website">
<meta property="og:image" content="<%= base %>/static/logo.png">
<meta name="twitter:card" content="summary">
<meta name="twitter:image" content="<%= base %>/static/logo.png">
<meta name="theme-color" content="#0b0d10">
</head>
<body>
<header class="topbar">
  <a href="/" class="brand">
    <img src="/static/logo.png" alt="" width="24" height="24">
    <%= appName %>
  </a>
  <span class="spacer"></span>
  <nav>
    <% if (typeof user !== "undefined" && user) { %>
      <a href="/dashboard"><span>Dashboard</span></a>
      <% if (typeof isOperator === "function" && isOperator(user)) { %><a href="/admin"><span>Admin</span></a><% } %>
      <span class="user-chip"><img src="<%= avatarUrl(user) %>" alt=""><span><%= user.username %></span></span>
      <a href="/auth/logout" class="btn ghost sm">Log out</a>
    <% } else { %>
      <a href="/auth/login" class="btn sm">Log in with Discord</a>
    <% } %>
  </nav>
</header>
<% if (typeof guild !== "undefined" && guild) { %>
<div class="app">
  <%- include("sidebar") %>
  <div class="content">
<% } else { %>
<main>
<% } %>
