<div class="guildhead">
  <% if (guildIconUrl(guild)) { %><img src="<%= guildIconUrl(guild) %>" alt="" class="gicon"><% } %>
  <h1><%= guild.name %></h1>
</div>
<nav class="tabs">
  <a href="/dashboard/<%= guild.id %>" class="<%= tab === 'settings' ? 'active' : '' %>">Settings</a>
  <a href="/dashboard/<%= guild.id %>/cases" class="<%= tab === 'cases' ? 'active' : '' %>">Cases</a>
  <a href="/dashboard/<%= guild.id %>/shifts" class="<%= tab === 'shifts' ? 'active' : '' %>">Shifts</a>
  <a href="/dashboard/<%= guild.id %>/banreqs" class="<%= tab === 'banreqs' ? 'active' : '' %>">Ban requests</a>
</nav>
