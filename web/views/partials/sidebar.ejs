<%
const I = {
  overview: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>',
  settings: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9c.29.24.66.38 1.05.38H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>',
  cases: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg>',
  perms: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>',
  shifts: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>',
  loa: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 22h20M6 18V7l6-4 6 4v11M10 22v-5h4v5"/></svg>',
  appeals: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>',
  banreqs: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m4.9 4.9 14.2 14.2"/></svg>',
  hints: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.3 1 2.1V17h6v-.2c0-.8.4-1.6 1-2.1A7 7 0 0 0 12 2z"/></svg>',
  templates: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>',
  erlc: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="10" rx="2"/><path d="M6 11h.01M10 11h.01M14 11h4M6 15h12"/></svg>',
};
const link = (path, key, label, badge) => {
  const active = tab === key ? ' active' : '';
  const href = '/dashboard/' + guild.id + (path ? '/' + path : '/overview');
  const b = badge ? ` <span class="badge warn" style="margin-left:auto">${badge}</span>` : '';
  return `<a href="${href}" class="${active.trim()}">${I[key] || ''}<span>${label}</span>${b}</a>`;
};
%>
<aside class="sidebar">
  <div class="g-head">
    <% if (guildIconUrl(guild)) { %><img src="<%= guildIconUrl(guild) %>" alt=""><% } else { %><div class="noicon"><%= (guild.name||'?')[0] %></div><% } %>
    <span class="nm"><%= guild.name %></span>
  </div>
  <nav class="nav">
    <%- link('overview', 'overview', 'Overview') %>
    <%- link('', 'settings', 'Settings') %>
    <div class="sep"></div>
    <%- link('cases', 'cases', 'Cases') %>
    <%- link('shifts', 'shifts', 'Shifts') %>
    <%- link('loa', 'loa', 'Leave of absence', typeof counts !== 'undefined' ? counts.loa : 0) %>
    <%- link('appeals', 'appeals', 'Appeals', typeof counts !== 'undefined' ? counts.appeals : 0) %>
    <%- link('banreqs', 'banreqs', 'Ban requests', typeof counts !== 'undefined' ? counts.banreqs : 0) %>
    <div class="sep"></div>
    <%- link('erlc', 'erlc', 'ER:LC servers') %>
    <%- link('templates', 'templates', 'Templates &amp; send') %>
    <%- link('autohints', 'autohints', 'Auto-hints') %>
    <%- link('permissions', 'permissions', 'Permissions') %>
  </nav>
  <a href="/dashboard" class="back">← All servers</a>
</aside>
