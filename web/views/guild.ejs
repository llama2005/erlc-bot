<%- include("partials/head", { title: "Settings · " + guild.name }) %>

<div class="page-head">
  <div><h1>Settings</h1><div class="sub">Changes sync to the bot instantly. You can also use <code>/config</code> in Discord.</div></div>
</div>
<% if (saved) { %><div class="flash">✓ Settings saved.</div><% } %>

<%
function chanSelect(name, selected, type) {
  const list = type != null ? channels.filter(c => c.type === type) : channels.filter(c => c.type !== 4);
  let h = `<select name="${name}"><option value="">— none —</option>`;
  list.forEach(c => { h += `<option value="${c.id}"${c.id === selected ? " selected" : ""}>${c.type === 4 ? "[cat] " : "#"}${c.name}</option>`; });
  return h + "</select>";
}
function roleSelect(name, selected) {
  let h = `<select name="${name}"><option value="">— none —</option>`;
  roles.forEach(r => { h += `<option value="${r.id}"${r.id === selected ? " selected" : ""}>@${r.name}</option>`; });
  return h + "</select>";
}
%>

<form method="post" action="/dashboard/<%= guild.id %>" class="settings">
  <section class="card">
    <h2>General</h2>
    <label>Prefix <input type="text" name="prefix" value="<%= cfg.prefix %>" maxlength="5" size="4"></label>
    <label class="check"><input type="checkbox" name="aiEnabled" <%= cfg.aiEnabled ? "checked" : "" %>> AI command &amp; @mention replies</label>
    <label class="check"><input type="checkbox" name="reasonRequired" <%= cfg.reasonRequired ? "checked" : "" %>> Require a reason on every moderation action</label>
    <label class="check"><input type="checkbox" name="logExternalModeration" <%= cfg.logExternalModeration ? "checked" : "" %>> Log Discord bans/kicks/timeouts done outside the bot (needs the bot to have View Audit Log)</label>
    <label class="check"><input type="checkbox" name="hardVoid" <%= cfg.hardVoid ? "checked" : "" %>> Voiding a case deletes it and its log message (uncheck to keep a greyed-out record instead)</label>
  </section>

  <section class="card">
    <h2>Log channels</h2>
    <label>Moderation cases <%- chanSelect("modlogChannel", cfg.modlogChannel) %></label>
    <label>Bot command usage <%- chanSelect("commandLogChannel", cfg.commandLogChannel) %></label>
    <label>Ban requests <%- chanSelect("banreqChannel", cfg.banreqChannel) %></label>
    <label>ER:LC joins / leaves <%- chanSelect("joinLogChannel", cfg.joinLogChannel) %></label>
    <label>ER:LC kill logs <%- chanSelect("killLogChannel", cfg.killLogChannel) %></label>
    <label>ER:LC in-game commands <%- chanSelect("ingameLogChannel", cfg.ingameLogChannel) %></label>
    <label>ER:LC mod calls (pings staff) <%- chanSelect("modcallLogChannel", cfg.modcallLogChannel) %></label>
    <label>Session (SSU/SSD) announcements <%- chanSelect("sessionChannel", cfg.sessionChannel) %></label>
    <label>Staff-alert — off-duty command use is reported here <%- chanSelect("staffAlertChannel", cfg.staffAlertChannel) %></label>
    <label>Leave-of-absence requests <%- chanSelect("loaChannel", cfg.loaChannel) %></label>
    <label>Ban appeals <%- chanSelect("appealChannel", cfg.appealChannel) %></label>
    <label>Shift log — clock-in/out &amp; shift-admin actions <%- chanSelect("shiftLogChannel", cfg.shiftLogChannel) %></label>
    <label>ER:LC server up/down alerts <%- chanSelect("statusChannel", cfg.statusChannel) %></label>
    <label>Announcements (default for /announce) <%- chanSelect("announceChannel", cfg.announceChannel) %></label>
    <label>Weekly staff-quota report <%- chanSelect("quotaChannel", cfg.quotaChannel) %></label>
  </section>

  <section class="card">
    <h2>In-game auto-log</h2>
    <label class="check"><input type="checkbox" name="ingameAutolog" <%= cfg.ingameAutolog ? "checked" : "" %>> Turn <code>:kick</code> / <code>:ban</code> / <code>:jail</code> run in-game — and <code>:pm &lt;player&gt; &lt;trigger&gt; &lt;reason&gt;</code> — into logged cases</label>
    <label>Warn trigger word (used in <code>:pm player <trigger> reason</code>) <input type="text" name="ingameWarnTrigger" value="<%= cfg.ingameWarnTrigger || 'warn' %>" maxlength="16" size="10"></label>
    <label class="check"><input type="checkbox" name="ingameShiftCommands" <%= cfg.ingameShiftCommands ? "checked" : "" %>> Let staff start/end a shift in-game by PMing the trigger: <code>:pm &lt;name&gt; clockin</code> / <code>:pm &lt;name&gt; clockout</code> (they must have run <code>/verify</code>)</label>
  </section>

  <section class="card">
    <h2>Staff quotas</h2>
    <label>Weekly cases per staff (0 = off) <input type="number" name="weeklyCaseQuota" value="<%= cfg.weeklyCaseQuota || 0 %>" min="0" size="4"></label>
    <label>Weekly shift-time per staff, in minutes (0 = off) <input type="number" name="weeklyShiftQuotaMin" value="<%= Math.round((cfg.weeklyShiftQuota || 0) / 60000) %>" min="0" size="5"></label>
    <p class="muted">A report posts to the quota channel each week.</p>
  </section>

  <section class="card">
    <h2>Tickets</h2>
    <label>Ticket category <%- chanSelect("ticketCategory", cfg.ticketCategory, 4) %></label>
    <label>Ticket staff role <%- roleSelect("ticketStaffRole", cfg.ticketStaffRole) %></label>
  </section>

  <section class="card">
    <h2>Roles</h2>
    <label>Staff — ER:LC / moderation / shift / session commands <%- roleSelect("erlcStaffRole", cfg.erlcStaffRole) %></label>
    <label>Admin — approve ban requests, shift admin, void others' cases <%- roleSelect("erlcAdminRole", cfg.erlcAdminRole) %></label>
    <label>On-duty — auto-assigned while clocked in <%- roleSelect("shiftRole", cfg.shiftRole) %></label>
    <label>Session ping — pinged on SSU/SSD <%- roleSelect("sessionPingRole", cfg.sessionPingRole) %></label>
  </section>

  <section class="card">
    <h2>ER:LC servers</h2>
    <p class="muted">Connect one or more ER:LC private servers — <a href="/dashboard/<%= guild.id %>/erlc">manage them here</a>.</p>
  </section>

  <section class="card">
    <h2>Disabled modules</h2>
    <div class="modgrid">
      <% modules.forEach(function(m){ %>
        <label class="check"><input type="checkbox" name="disabledModules" value="<%= m %>" <%= cfg.disabledModules.includes(m) ? "checked" : "" %>> <%= m %></label>
      <% }) %>
    </div>
  </section>

  <button type="submit" class="btn big">Save settings</button>
</form>
<%- include("partials/foot") %>
